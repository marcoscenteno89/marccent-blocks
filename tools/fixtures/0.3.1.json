	"button": "<!-- wp:marccent/button {\"label\":\"Message me\",\"href\":\"/contact\",\"icon\":\"message\"} -->\n<a href=\"/contact\" class=\"btn wp-block-marccent-button primary\" aria-label=\"Message me\" title=\"Message me\" data-component=\"button\"><i data-component=\"icon\" class=\"fa-solid fa-message btn-icon\" aria-hidden=\"true\"></i><span class=\"btn-text\">Message me</span></a>\n<!-- /wp:marccent/button -->\n\n<!-- wp:marccent/button {\"label\":\"Github\",\"href\":\"https://github.com/x\",\"icon\":\"fa-brands fa-github\",\"color\":\"secondary\",\"hover\":\"hover-expand\",\"newTab\":true,\"anchor\":\"gh\"} -->\n<a href=\"https://github.com/x\" class=\"btn wp-block-marccent-button secondary hover-expand\" aria-label=\"Github\" title=\"Github\" data-component=\"button\" target=\"_blank\" rel=\"noopener noreferrer\" id=\"gh\"><i data-component=\"icon\" class=\"fa-brands fa-github btn-icon\" aria-hidden=\"true\"></i><span class=\"btn-text\">Github</span></a>\n<!-- /wp:marccent/button -->\n\n<!-- wp:marccent/button {\"label\":\"Call\",\"href\":\"tel:+12085550100\",\"icon\":\"phone\",\"hover\":\"hover-trace\",\"trace\":true} -->\n<a href=\"tel:+12085550100\" class=\"btn wp-block-marccent-button primary hover-trace\" aria-label=\"Call\" title=\"Call\" data-component=\"button\"><i data-component=\"icon\" class=\"fa-solid fa-phone btn-icon\" aria-hidden=\"true\"></i><span class=\"btn-text\">Call</span><svg data-component=\"trace\" class=\"trace\" aria-hidden=\"true\"><rect pathLength=\"100\"></rect></svg></a>\n<!-- /wp:marccent/button -->\n\n<!-- wp:marccent/button {\"label\":\"Read more\",\"href\":\"/about\",\"icon\":\"\"} -->\n<a href=\"/about\" class=\"btn-link wp-block-marccent-button primary\" data-component=\"button\">Read more</a>\n<!-- /wp:marccent/button -->\n\n<!-- wp:marccent/button {\"label\":\"Nowhere\",\"icon\":\"star\"} -->\n<button type=\"button\" class=\"btn wp-block-marccent-button primary\" aria-label=\"Nowhere\" title=\"Nowhere\" data-component=\"
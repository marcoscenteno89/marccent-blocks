	"animated": "<!-- wp:marccent/animation {\"name\":\"wave\",\"fps\":30,\"colors\":\"#fff, #1ecbe1\",\"surface\":\"bg\"} -->\n<section class=\"wp-block-marccent-animation wrap wrap-fluid pad-0 stack bg\" style=\"min-height:60vh\"><div data-component=\"animation\" data-name=\"wave\" data-fps=\"30\" data-colors=\"#fff, #1ecbe1\" class=\"bg w-100 h-100\" aria-hidden=\"true\"></div><div class=\"col-center pad text-center\" style=\"position:relative;grid-template-columns:minmax(0, 1fr)\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Hi</h2>\n<!-- /wp:heading --></div></section>\n<!-- /wp:marccent/animation -->\n\n<!-- wp:marccent/animation -->\n<section class=\"wp-block-marccent-animation wrap wrap-fluid pad-0 stack\" style=\"min-height:60vh\"><div data-component=\"animation\" data-name=\"network-loop\" class=\"bg w-100 h-100\" aria-hidden=\"true\"></div><div class=\"col-center pad text-center\" style=\"position:relative;grid-template-columns:minmax(0, 1fr)\"><!-- wp:paragraph -->\n<p>Plain</p>\n<!-- /wp:paragraph --></div></section>\n<!-- /wp:marccent/animation -->",

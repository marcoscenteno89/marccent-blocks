{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "marccent/radial-menu",
	"title": "Radial menu",
	"category": "marccent",
	"icon": "marker",
	"description": "One round button that opens a ring of items around itself (a speed dial).",
	"keywords": [ "speed dial", "fab", "menu", "circle" ],
	"textdomain": "marccent-blocks",
	"attributes": {
		"radius": { "type": "string", "default": "5rem" },
		"label": { "type": "string", "default": "Quick menu" },
		"version": { "type": "number" }
	},
	"supports": { "html": false, "anchor": true },
	"allowedBlocks": [ "marccent/radial-menu-item", "marccent/loop" ],
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}

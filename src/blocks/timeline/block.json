{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "marccent/timeline",
	"title": "Timeline",
	"category": "marccent",
	"icon": "backup",
	"description": "Events down a gradient line, each marked by a hexagon with its icon and told in a card: a history, a process, milestones.",
	"keywords": [ "history", "milestones", "process", "steps", "events" ],
	"textdomain": "marccent-blocks",
	"attributes": {
		"version": { "type": "number" }
	},
	"supports": { "html": false, "anchor": true },
	"allowedBlocks": [ "marccent/timeline-item", "marccent/loop" ],
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}

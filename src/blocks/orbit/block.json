{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "marccent/orbit",
	"title": "Orbit",
	"category": "marccent",
	"icon": "image-rotate",
	"description": "Items on a ring around a hub that turns to the one picked (or by itself); or the orbit clock, or a solar system.",
	"keywords": [ "orbit", "circle", "wheel", "clock", "solar system" ],
	"textdomain": "marccent-blocks",
	"attributes": {
		"items": {
			"type": "array",
			"default": [
				{
					"title": "Plan",
					"text": "We listen first."
				},
				{
					"title": "Build",
					"text": "Then we make it."
				},
				{
					"title": "Launch",
					"text": "And ship it."
				}
			]
		},
		"startAngle": { "type": "number", "default": 0 },
		"autoPlay": { "type": "boolean", "default": false },
		"interval": { "type": "number", "default": 4000 },
		"kind": { "type": "string", "default": "items" },
		"version": { "type": "number" }
	},
	"supports": { "html": false, "anchor": true },
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}

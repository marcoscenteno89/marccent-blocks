{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "marccent/grid",
	"title": "Grid",
	"category": "marccent",
	"icon": "grid-view",
	"description": "Lays its blocks out on the theme's grid: equal columns that wrap when there's no room, a row, or an uneven layout (2 : 1…).",
	"keywords": [ "columns", "row", "layout" ],
	"textdomain": "marccent-blocks",
	"attributes": {
		"layout": { "type": "string", "default": "cols" },
		"columns": { "type": "number", "default": 3 },
		"minimumColumnWidth": { "type": "string", "default": "" },
		"gap": { "type": "string", "default": "" },
		"alignItems": { "type": "string", "default": "" },
		"center": { "type": "boolean", "default": false },
		"dense": { "type": "boolean", "default": false },
		"minimumRowHeight": { "type": "string", "default": "" },
		"version": { "type": "number" }
	},
	"supports": { "anchor": true, "html": false },
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}

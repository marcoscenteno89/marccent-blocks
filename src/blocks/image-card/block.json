{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "marccent/image-card",
	"title": "Image card",
	"category": "marccent",
	"icon": "format-image",
	"description": "A photo that fills the card with its text and buttons in front, always readable: a fade, frosted glass, blur, a tint. Or a live canvas animation instead of the photo.",
	"keywords": [ "photo", "picture", "hero", "overlay", "card" ],
	"textdomain": "marccent-blocks",
	"attributes": {
		"src": { "type": "string", "default": "" },
		"alt": { "type": "string", "default": "" },
		"canvas": { "type": "string", "default": "" },
		"label": { "type": "string", "default": "Label" },
		"title": { "type": "string", "default": "A title" },
		"text": { "type": "string", "default": "" },
		"overlay": { "type": "string", "default": "fade" },
		"align": { "type": "string", "default": "end" },
		"badge": { "type": "string", "default": "" },
		"big": { "type": "boolean", "default": false },
		"ratio": { "type": "string", "default": "4 / 5" },
		"position": { "type": "string", "default": "center" },
		"shape": { "type": "string", "default": "rounded" }
	},
	"supports": { "html": false, "anchor": true },
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}

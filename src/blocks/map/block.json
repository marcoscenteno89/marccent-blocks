{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "marccent/map",
	"title": "Map",
	"category": "marccent",
	"icon": "location-alt",
	"description": "The theme's Google map, in the site's colors, with a pin. Left empty, it shows the business (Settings → Business: its coordinates and Google Maps link); its key is the business's too. Without a key, Google's plain map.",
	"keywords": [ "map", "google", "location", "directions" ],
	"textdomain": "marccent-blocks",
	"attributes": {
		"lat": { "type": "string", "default": "" },
		"lng": { "type": "string", "default": "" },
		"zoom": { "type": "number", "default": 10 },
		"marker": { "type": "boolean", "default": true },
		"title": { "type": "string", "default": "" },
		"link": { "type": "string", "default": "" }
	},
	"supports": { "html": false, "anchor": true },
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}

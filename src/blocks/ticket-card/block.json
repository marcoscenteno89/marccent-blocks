{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "marccent/ticket-card",
	"title": "Ticket card",
	"category": "marccent",
	"icon": "tickets-alt",
	"description": "A card shaped as a ticket, split by a tear line: a label, a big title and a note on top with its button, a list below. A pricing plan, a pass, a coupon.",
	"keywords": [ "pricing", "plan", "price", "ticket", "coupon" ],
	"textdomain": "marccent-blocks",
	"attributes": {
		"label": { "type": "string", "default": "Pro" },
		"title": { "type": "string", "default": "$29" },
		"note": { "type": "string", "default": "a month" },
		"items": {
			"type": "array",
			"default": [
				{
					"text": "Everything in Basic"
				},
				{
					"text": "Priority support"
				}
			]
		},
		"ribbon": { "type": "string", "default": "" }
	},
	"supports": { "html": false, "anchor": true },
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
